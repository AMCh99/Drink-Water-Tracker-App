<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp"
    android:background="@drawable/widget_background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <FrameLayout
            android:layout_width="122dp"
            android:layout_height="122dp"
            android:layout_gravity="center">

            <ImageView
                android:id="@+id/ring_track"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_ring_track"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/ring_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_ring_progress"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/progress_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#12324E"
                    android:textStyle="bold"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/water_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="0 ml"
                    android:textColor="#3F5872"
                    android:textStyle="bold"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/water_goal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cel: 2000 ml"
            android:textColor="#4E6A86"
            android:textSize="12sp" />

    </LinearLayout>

</RelativeLayout>
