<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_small_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp"
    android:background="@drawable/widget_background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/water_icon_small"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/water_drop"
            android:tint="#1A86FF"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/progress_percent_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="0%"
            android:textColor="#12324E"
            android:textStyle="bold"
            android:textSize="18sp"
            android:maxLines="1"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/water_amount_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="0 ml"
            android:textColor="#4E6A86"
            android:textSize="10sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false" />

        <ProgressBar
            android:id="@+id/water_progress_small"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#1A86FF"
            android:progressBackgroundTint="#BFD6F7" />
    </LinearLayout>

</RelativeLayout>
